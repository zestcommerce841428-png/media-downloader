# ── Production .env for Hostinger VPS ────────────────────────────────────────
# Copy this to .env on the VPS and fill in every value.
# NEVER commit this file or .env to git.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Use strong random passwords — e.g.  openssl rand -hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# ── Clerk (use PRODUCTION keys: pk_live_ / sk_live_) ─────────────────────────
# Dashboard → API Keys → Production instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_XXXX
CLERK_SECRET_KEY=sk_live_XXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/download
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/download

# ── Admin access ──────────────────────────────────────────────────────────────
# Comma-separated emails that can access /admin
ADMIN_EMAILS=your@email.com

# ── TMDB (https://www.themoviedb.org/settings/api) ───────────────────────────
TMDB_API_KEY=YOUR_TMDB_API_KEY
TMDB_ACCESS_TOKEN=YOUR_TMDB_ACCESS_TOKEN

# ── Optional integrations ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890
NEXT_PUBLIC_SITE_NAME=MediaDL
