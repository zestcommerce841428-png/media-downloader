# ── Production .env ───────────────────────────────────────────────────────────
# Copy this to .env on your VPS and fill in every value.
# NEVER commit this file or .env to git.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Use strong random passwords — e.g. openssl rand -hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# ── Supabase (use PRODUCTION project — not a dev project) ─────────────────────
# Dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Bootstrap super admin — gets super_admin role on first backend startup
SUPER_ADMIN_EMAIL=your@email.com

# CORS — set to your real domain(s)
ALLOWED_ORIGINS=https://yourdomain.com

# ── TMDB (https://www.themoviedb.org/settings/api) ────────────────────────────
TMDB_API_KEY=YOUR_TMDB_API_KEY
TMDB_ACCESS_TOKEN=YOUR_TMDB_ACCESS_TOKEN

# ── SMTP (optional — for custom email notifications) ──────────────────────────
SMTP_PROVIDER=custom
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=MediaDL <noreply@yourdomain.com>
SMTP_ADMIN_TO=your@email.com

# ── Firebase (optional — push notifications) ──────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ── Optional integrations ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=MediaDL
