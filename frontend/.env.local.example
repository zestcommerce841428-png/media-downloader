# ── Supabase — fill in from https://supabase.com/dashboard ────────────────────
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend (DEVELOPMENT — host `npm run dev`) ──────────────────────────────────
# Dev runs the frontend on the host and talks to the dockerised backend on
# localhost. For phone / LAN / production use the full docker stack instead
# (docker compose up -d → nginx on :80, same-origin — no CORS/scheme issues).
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORAGE_PROVIDER=hostinger
