# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_PASSWORD=mediadlpass

# ── Supabase (https://supabase.com — free tier available) ─────────────────────
# Dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Bootstrap super admin — gets super_admin role automatically on first startup
SUPER_ADMIN_EMAIL=your@email.com

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── TMDB (https://www.themoviedb.org/settings/api) ────────────────────────────
TMDB_API_KEY=YOUR_TMDB_API_KEY
TMDB_ACCESS_TOKEN=YOUR_TMDB_ACCESS_TOKEN

# ── Google Analytics ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google reCAPTCHA v3 ───────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# ── Google AdSense ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX

# ── Tawk.to (https://tawk.to — free) ─────────────────────────────────────────
NEXT_PUBLIC_TAWK_PROPERTY_ID=XXXXXXXXXX
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# ── WhatsApp ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=+1234567890

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=MediaDL
